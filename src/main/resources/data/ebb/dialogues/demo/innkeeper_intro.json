              "tag": "private_bargain"
            },
            {
              "type": "set_npc_routine",
              "id": "ebb:demo/innkeeper_backroom"
            }
          ]
        },
        {
          "id": "dread_chime_thought",
          "type": "thought",
          "text": "【Dread】把最坏的结局先摆到桌上。",
          "next": "dread_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
