          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_dread"
            }
          ]
        },
        {
          "id": "empathy_chime_thought",
          "type": "thought",
          "text": "【Empathy】先说出他正在保护什么。",
          "next": "empathy_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/empathy",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_empathy"
            }
          ]
        },
        {
          "id": "endurance_chime_thought",
          "type": "thought",
          "text": "【Endurance】让沉默再多压一秒。",
          "next": "endurance_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/endurance",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_endurance"
            }
          ]
        },
        {
          "id": "finesse_chime_thought",
          "type": "thought",
          "text": "【Finesse】盯住他的手，而不是他的嘴。",
          "next": "finesse_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/finesse",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_finesse"
            }
          ]
        },
        {
          "id": "force_chime_thought",
          "type": "thought",
          "text": "【Force】把房间里的重量挪到你这边。",
          "next": "force_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/force",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_force"
            }
          ]
        },
        {
          "id": "instinct_chime_thought",
          "type": "thought",
          "text": "【Instinct】顺着那一下不自然的停顿追问。",
          "next": "instinct_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/instinct",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_instinct"
            }
          ]
        },
        {
          "id": "logic_chime_thought",
          "type": "thought",
          "text": "【Logic】重排钥匙、门和敲击的顺序。",
          "next": "logic_chime_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/logic",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_logic"
            }
          ]
        },
        {
          "id": "rhetoric_insight",
          "type": "thought",
          "text": "【Rhetoric】换个问法：钥匙会让谁失去控制权？",
          "next": "rhetoric_line",
          "conditions": [
            {
              "type": "flag",
              "scope": "player",
              "id": "chime:ebb:demo/rhetoric",
              "value": true
            }
          ],
          "effects": [
            {
              "type": "add_thought",
              "id": "ebb:demo/thought_rhetoric"
            }
          ]
        },
        {
          "id": "trusted_followup",
          "type": "dialogue",
          "text": "你刚才确实帮了我。现在能说真话了吗？",
          "next": "trusted_line",
          "conditions": [
            {
              "type": "story_var",
              "scope": "player",
              "layer": "major",
              "id": "innkeeper_trust",
              "min": 1
            }
          ]
        },
        {
          "id": "authority_followup",
          "type": "dialogue",
          "text": "你知道我现在能让整间旅馆听见这句话。",
          "next": "authority_line",
          "conditions": [
            {
              "type": "has_feat",
              "id": "ebb:demo/tavern_authority"
            }
          ]
        },
        {
          "id": "public_echo",
          "type": "thought",
          "text": "公开路线已经扎根；这场旅馆事件会以证词而不是钥匙结尾。",
          "next": "public_echo",
          "conditions": [
            {
              "type": "story_var",
              "scope": "player",
              "layer": "branch",
              "id": "tavern_route",
              "value": "public"
            }
          ]
        },
        {
          "id": "guarded_memory",
          "type": "dialogue",
          "text": "你刚才退了一步。现在他会把每个问题都当成破门。",
          "next": "guarded_memory_line",
          "conditions": [
            {
              "type": "npc_state",
              "npc": "ebb:demo/innkeeper",
              "tag": "guarded"
            }
          ]
        },
        {
          "id": "trusted_relation",
          "type": "dialogue",
          "text": "你已经欠了我一分信任。把它用在真话上。",
          "next": "trusted_relation_line",
          "conditions": [
            {
              "type": "relation_at_least",
              "relation": "ebb:demo/innkeeper",
              "min": 2
            }
          ]
        },
        {
          "id": "night_counter",
          "type": "thought",
          "text": "夜里，柜台后面的沉默更像供词。",
          "next": "night_counter_line",
          "conditions": [
            {
              "type": "time_window",
              "start": 12000,
              "end": 24000
            }
          ]
        },
        {
          "id": "leave",
          "type": "action",
          "text": "结束交谈"
        }
      ]
    },
    "door_hint": {
      "speaker": "innkeeper",
      "text": "“门会告诉你它愿意告诉你的东西。先别用肩膀，年轻人。”",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "换个问题。",
          "next": "start"
        },
        {
          "id": "leave",
          "type": "action",
          "text": "离开"
        }
      ]
    },
    "expression": {
      "speaker": "inner voice",
      "text": "这不是恐惧，是一种职业性的疲惫。每天都有人问那扇门。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "回到谈话。",
          "next": "start"
        }
      ]
    },
    "push_success": {
      "speaker": "innkeeper",
      "text": "他叹了口气，把一枚不存在于物品栏里的钥匙推向你。至少，现在状态记住了这件事。",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "继续。",
          "next": "start"
        }
      ]
    },
    "push_failure": {
      "speaker": "innkeeper",
      "text": "“你把威胁说得像是在背菜单。” 他把钥匙收得更远。",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "重新组织语言。",
          "next": "start"
        }
      ]
    },
    "trusted_line": {
      "speaker": "innkeeper",
      "text": "他压低声音：“你要的不是钥匙。你要知道谁把门锁上，又为什么所有人都装作没听见。”",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "把这句话记住。",
          "next": "start"
        }
      ]
    },
    "public_ending_placeholder": {
      "speaker": "narrator",
      "text": "【Branch 占位】你选择把门的秘密推到公共视野里。真正的垂直切片结局会读取 Branch.tavern_route=public。",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "暂时回到柜台。",
          "next": "start"
        }
      ]
    },
    "quiet_ending_placeholder": {
      "speaker": "narrator",
      "text": "【Branch 占位】你选择安静处理，把事实留在少数人的口袋里。真正的垂直切片结局会读取 Branch.tavern_route=quiet。",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "暂时回到柜台。",
          "next": "start"
        }
      ]
    },
    "authority_line": {
      "speaker": "innkeeper",
      "text": "他看了一眼楼梯，又看你：“现在你说话会留下痕迹。别浪费这个坏习惯。”",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "把权威感收好。",
          "next": "start"
        }
      ]
    },
    "rhetoric_line": {
      "speaker": "inner voice",
      "text": "这不是钥匙问题，是叙事控制问题。把问题改成“谁需要这扇门继续保持神秘”。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这个角度带回谈话。",
          "next": "start"
        }
      ]
    },
    "public_echo": {
      "speaker": "inner voice",
      "text": "公开不是善良，它是一种把责任分摊给房间里每个人的技术。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "回到谈话。",
          "next": "start"
        }
      ]
    },
    "guarded_memory_line": {
      "speaker": "innkeeper",
      "text": "“门的问题已经让一个肩膀受伤。我不想看见第二个。” 他把钥匙说成伤口，而不是工具。",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "回到柜台。",
          "next": "start"
        }
      ]
    },
    "trusted_relation_line": {
      "speaker": "innkeeper",
      "text": "他用指节敲了敲柜台：“真话不是钥匙。真话是钥匙丢失以后，人们还假装门锁着。”",
      "choices": [
        {
          "id": "back",
          "type": "dialogue",
          "text": "让这句话留下来。",
          "next": "start"
        }
      ]
    },
    "night_counter_line": {
      "speaker": "inner voice",
      "text": "白天他守着生意；夜里他守着版本。两个 routine，共用同一个人。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "回到谈话。",
          "next": "start"
        }
      ]
    },
    "dread_chime_line": {
      "speaker": "inner voice",
      "text": "如果他继续沉默，后果会替他说话。把这个坏预感当作地图，而不是恐吓。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    },
    "empathy_chime_line": {
      "speaker": "inner voice",
      "text": "他把拒绝说得很硬，是因为软的部分已经被问过太多次。先碰那一处。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    },
    "endurance_chime_line": {
      "speaker": "inner voice",
      "text": "谈话里有一种体力活：不急着填补空白，让对方先承认自己撑不住。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    },
    "finesse_chime_line": {
      "speaker": "inner voice",
      "text": "手指比台词诚实。柜台边缘、钥匙位置、收回手的速度，全都在给你第二套证词。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    },
    "force_chime_line": {
      "speaker": "inner voice",
      "text": "力量不是把门撞开；力量是让所有人突然意识到，这扇门已经占用了太多空间。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    },
    "instinct_chime_line": {
      "speaker": "inner voice",
      "text": "那一瞬间的停顿不是犹豫，是身体替他检查退路。顺着这个检查问下去。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    },
    "logic_chime_line": {
      "speaker": "inner voice",
      "text": "把事实按时间放回去：钥匙在外，敲击在内，恐惧在两者之间迟到。",
      "choices": [
        {
          "id": "back",
          "type": "thought",
          "text": "把这条内心路线带回谈话。",
          "next": "start"
        }
      ]
    }
  }
}
